# Copie este arquivo para .env.local (desenvolvimento) ou cadastre as variáveis
# no painel da hospedagem (Vercel: Settings → Environment Variables;
# Netlify: Site configuration → Environment variables).
# Nenhuma destas variáveis é secreta: todas são públicas (NEXT_PUBLIC_*).

# URL pública do site, sem barra no final. Usada em SEO, sitemap, Open Graph e
# dados estruturados. Se ficar vazia, usa a URL do Netlify ou da Vercel.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ID de medição do Google Analytics 4 (formato G-XXXXXXXXXX). Deixe vazio para
# desativar. O GA só é carregado depois que o visitante aceita os cookies.
NEXT_PUBLIC_GA_ID=

# Ambiente de revisão: exibe serviços, produtos e perguntas ainda NÃO confirmados
# (com o selo "Rascunho"). Mantenha "false" em produção.
NEXT_PUBLIC_SHOW_DRAFTS=false

# Ambiente de revisão: exibe o portfólio de demonstração com imagens ilustrativas
# de bancos de imagens. Mantenha "false" em produção até haver fotos reais.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=false
